<Window x:Class="CukraszdaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cukrászda" Height="350" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="MistyRose">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fájl">
                <MenuItem Header="_Megnyitás..." Click="Megnyitas_Click"/>
                <Separator/>
                <MenuItem Header="_Kilépés" Click="Kilepes_Click"/>
            </MenuItem>
            <MenuItem x:Name="SutemenyekMenuItem" Header="sutemenyek"
                      IsEnabled="False" Click="Sutemenyek_Click"/>
            <MenuItem Header="_Névjegy" Click="Nevjegy_Click"/>
        </Menu>

        <TextBlock DockPanel.Dock="Bottom" Margin="10"
                   HorizontalAlignment="Center" x:Name="InfoTextBlock"
                   Text="Nyissa meg a választékot a Fájl / Megnyitás menüponttal!"/>

        <TextBlock Text="Cukrászda"
                   FontFamily="Segoe Script" FontSize="36" FontWeight="Bold"
                   Foreground="Chocolate"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DockPanel>
</Window>
